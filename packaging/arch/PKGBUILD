package_frankenstein-core() {
  pkgdesc='Common CLI and default-session manager for Frankenstein'
  depends=(
    bash coreutils diffutils findutils gawk grep gum jq
    'omarchy=4.0.4-1'
    pacman polkit python sed sudo systemd tar
  )

  install -Dm0755 "$srcdir/frankenstein" "$pkgdir/usr/bin/frankenstein"
  install -Dm0755 "$srcdir/frankenstein-settings" "$pkgdir/usr/bin/frankenstein-settings"
  install -Dm0755 "$srcdir/install.sh" "$pkgdir/usr/lib/frankenstein/setup"
  install -Dm0755 "$srcdir/uninstall.sh" "$pkgdir/usr/lib/frankenstein/uninstall"
  install -Dm0755 "$srcdir/omarchy-default-desktop" \
    "$pkgdir/usr/bin/omarchy-default-desktop"
  install -Dm0755 "$srcdir/omarchy-desktop-manager-set-default" \
    "$pkgdir/usr/lib/frankenstein/set-default"
  install -Dm0755 "$srcdir/frankenstein-diagnostics" \
    "$pkgdir/usr/lib/frankenstein/diagnostics"
  install -Dm0755 "$srcdir/frankenstein-state" \
    "$pkgdir/usr/lib/frankenstein/state"
  install -Dm0644 "$srcdir/installer-state.sh" \
    "$pkgdir/usr/lib/frankenstein/installer-state"
  install -Dm0644 "$srcdir/shell-profile.sh" \
    "$pkgdir/usr/lib/frankenstein/shell-profile"
  install -Dm0644 "$srcdir/omarchy-desktop-manager-default.path" \
    "$pkgdir/usr/lib/systemd/system/omarchy-desktop-manager-default.path"
  install -Dm0644 "$srcdir/omarchy-desktop-manager-default.service" \
    "$pkgdir/usr/lib/systemd/system/omarchy-desktop-manager-default.service"

  install -Dm0644 "$srcdir/INSTALL.md" \
    "$pkgdir/usr/share/doc/frankenstein/INSTALL.md"
  install -Dm0644 "$srcdir/DISTRIBUTION.md" \
    "$pkgdir/usr/share/doc/frankenstein/DISTRIBUTION.md"
  install -Dm0644 "$srcdir/LICENSES-README.md" \
    "$pkgdir/usr/share/doc/frankenstein/LICENSES.md"
  install -Dm0644 "$srcdir/THIRD_PARTY_NOTICES.md" \
    "$pkgdir/usr/share/doc/frankenstein/THIRD_PARTY_NOTICES.md"
  install -Dm0644 "$srcdir/LICENSE" \
    "$pkgdir/usr/share/licenses/frankenstein-core/LICENSE"
  install -Dm0644 "$srcdir/MIT.txt" \
    "$pkgdir/usr/share/licenses/frankenstein-core/MIT-Omarchy.txt"
}

package_frankenstein-kde() {
  pkgdesc='KDE Plasma adapter for Frankenstein'
  depends=(
    "frankenstein-core=$pkgver-$pkgrel"
    breeze file imagemagick jq kdialog 'omarchy=4.0.4-1'
    plasma-desktop plasma-workspace qt6-declarative qt6-imageformats qt6-tools
    quickshell sddm systemsettings xdg-terminal-exec
  )

  install -Dm0755 "$srcdir/frankenstein-shell-adapter" \
    "$pkgdir/usr/bin/frankenstein-shell-adapter"
  install -Dm0755 "$srcdir/frankenstein-background" \
    "$pkgdir/usr/bin/frankenstein-background"
  install -Dm0755 "$srcdir/frankenstein-background-writer" \
    "$pkgdir/usr/libexec/frankenstein-background-writer"
  install -Dm0755 "$srcdir/frankenstein-sddm-validate" \
    "$pkgdir/usr/lib/frankenstein/sddm-validate"
  install -Dm0644 "$srcdir/sddm-Main.qml" \
    "$pkgdir/usr/share/sddm/themes/frankenstein/Main.qml"
  install -Dm0644 "$srcdir/sddm-metadata.desktop" \
    "$pkgdir/usr/share/sddm/themes/frankenstein/metadata.desktop"
  install -Dm0644 "$srcdir/sddm-theme.conf" \
    "$pkgdir/usr/share/sddm/themes/frankenstein/theme.conf"
  install -Dm0644 "$srcdir/vaporwave-default.png" \
    "$pkgdir/usr/share/sddm/themes/frankenstein/backgrounds/vaporwave-default.png"
  install -Dm0644 "$srcdir/plasma-shell-profile.json" \
    "$pkgdir/usr/share/frankenstein/profiles/plasma.json"
  install -Dm0644 "$srcdir/plasma-shell-profile.json.license" \
    "$pkgdir/usr/share/frankenstein/profiles/plasma.json.license"
  install -Dm0644 "$srcdir/plasma-menu.jsonc" \
    "$pkgdir/usr/share/frankenstein/profiles/plasma-menu.jsonc"
  install -Dm0644 "$srcdir/shell.qml" \
    "$pkgdir/usr/share/frankenstein/omarchy-shell/shell.qml"
  install -Dm0644 "$srcdir/PluginRegistry.qml" \
    "$pkgdir/usr/share/frankenstein/omarchy-shell/services/PluginRegistry.qml"
  install -Dm0644 "$srcdir/Menu.qml" \
    "$pkgdir/usr/share/frankenstein/omarchy-shell/plugins/menu/Menu.qml"

  ln -s /usr/share/omarchy/shell/Commons \
    "$pkgdir/usr/share/frankenstein/omarchy-shell/Commons"
  ln -s /usr/share/omarchy/shell/Ui \
    "$pkgdir/usr/share/frankenstein/omarchy-shell/Ui"
  ln -s /usr/share/omarchy/shell/plugins/bar \
    "$pkgdir/usr/share/frankenstein/omarchy-shell/plugins/bar"
  local source name
  for source in /usr/share/omarchy/shell/services/*; do
    name=${source##*/}
    [[ $name == PluginRegistry.qml ]] && continue
    ln -s "$source" "$pkgdir/usr/share/frankenstein/omarchy-shell/services/$name"
  done
  for source in /usr/share/omarchy/shell/plugins/menu/*; do
    name=${source##*/}
    [[ $name == Menu.qml ]] && continue
    ln -s "$source" "$pkgdir/usr/share/frankenstein/omarchy-shell/plugins/menu/$name"
  done

  install -Dm0644 "$srcdir/frankenstein-omarchy-shell.service" \
    "$pkgdir/usr/share/frankenstein/templates/frankenstein-omarchy-shell.service"
  install -Dm0644 "$srcdir/frankenstein-omarchy-shell-autostart.desktop" \
    "$pkgdir/usr/share/frankenstein/templates/frankenstein-omarchy-shell.desktop"
  install -Dm0644 "$srcdir/frankenstein-omarchy-menu.desktop" \
    "$pkgdir/usr/share/frankenstein/templates/frankenstein-omarchy-menu.desktop"
  install -Dm0644 "$srcdir/zzzz-frankenstein.conf" \
    "$pkgdir/usr/share/frankenstein/templates/zzzz-omarchy-desktop-manager.conf"

  install -Dm0644 "$srcdir/LICENSE" \
    "$pkgdir/usr/share/licenses/frankenstein-kde/LICENSE"
  install -Dm0644 "$srcdir/MIT.txt" \
    "$pkgdir/usr/share/licenses/frankenstein-kde/MIT-Omarchy.txt"
  install -Dm0644 "$srcdir/THIRD_PARTY_NOTICES.md" \
    "$pkgdir/usr/share/licenses/frankenstein-kde/THIRD_PARTY_NOTICES.md"
}
