# Maintainer: Frankenstein contributors

pkgbase=frankenstein
pkgname=(frankenstein-core frankenstein-kde)
pkgver=0.1.0
pkgrel=4
pkgdesc='Reversible Omarchy desktop compatibility manager'
arch=(x86_64)
license=(MIT)
options=(!strip)

_root=$startdir/../..
source=(
  "install.sh::file://$_root/install.sh"
  "uninstall.sh::file://$_root/uninstall.sh"
  "frankenstein::file://$_root/src/bin/frankenstein"
  "omarchy-default-desktop::file://$_root/src/bin/omarchy-default-desktop"
  "omarchy-desktop-manager-set-default::file://$_root/src/libexec/omarchy-desktop-manager-set-default"
  "omarchy-desktop-manager-default.path::file://$_root/src/systemd/omarchy-desktop-manager-default.path"
  "omarchy-desktop-manager-default.service::file://$_root/src/systemd/omarchy-desktop-manager-default.service"
  "frankenstein-shell-adapter::file://$_root/src/bin/frankenstein-shell-adapter"
  "plasma-shell-profile.json::file://$_root/src/frankenstein/plasma-shell-profile.json"
  "plasma-shell-profile.json.license::file://$_root/src/frankenstein/plasma-shell-profile.json.license"
  "plasma-menu.jsonc::file://$_root/src/frankenstein/plasma-menu.jsonc"
  "shell.qml::file://$_root/src/frankenstein/omarchy-shell/shell.qml"
  "PluginRegistry.qml::file://$_root/src/frankenstein/omarchy-shell/services/PluginRegistry.qml"
  "Menu.qml::file://$_root/src/frankenstein/omarchy-shell/plugins/menu/Menu.qml"
  "frankenstein-omarchy-shell.service::file://$_root/src/systemd/frankenstein-omarchy-shell.service"
  "frankenstein-omarchy-shell-autostart.desktop::file://$_root/src/frankenstein/frankenstein-omarchy-shell-autostart.desktop"
  "frankenstein-omarchy-menu.desktop::file://$_root/src/frankenstein/frankenstein-omarchy-menu.desktop"
  "zzzz-frankenstein.conf::file://$_root/src/frankenstein/zzzz-frankenstein.conf"
  "INSTALL.md::file://$_root/INSTALL.md"
  "DISTRIBUTION.md::file://$_root/DISTRIBUTION.md"
  "LICENSES-README.md::file://$_root/LICENSES/README.md"
  "LICENSE::file://$_root/LICENSE"
  "MIT.txt::file://$_root/LICENSES/MIT.txt"
  "THIRD_PARTY_NOTICES.md::file://$_root/THIRD_PARTY_NOTICES.md"
)

