#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Frankenstein contributors
# SPDX-License-Identifier: MIT

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: frankenstein COMMAND [OPTIONS]

Commands:
  watchdog      List incidents or show the latest flight recorder (tail)
  inspect       Read-only desktop, SDDM, ownership, and state inventory
  doctor        Diagnose configuration without changing the system
  verify        Require a valid installed theme and verified desktop session
  install       Install integration (alias for setup)
  switch        Choose a desktop session (alias for desktop)
  recover       Restore the recorded pre-install state (alias for uninstall)
  repair-sddm   Plan or install the Frankenstein chooser theme
  background    Import a local image into the safe SDDM background collection
  adopt-kde-shell
                Replace a preserved stock shell with the Plasma adapter
  preflight     Check compatibility and print the proposed KDE setup
  setup         Add KDE integration; preserve an existing Omarchy shell
  uninstall     Remove configuration while preserving KDE and backups
  settings      Choose individual Omarchy plugins/widgets to keep
  desktop       Choose a default desktop; offer a confirmed logout
  check         Check the preserved shell or filtered KDE adapter
  enable        Enable the filtered KDE adapter (when managed)
  disable       Disable the filtered KDE adapter (when managed)
  menu          Open the Omarchy setup menu under Plasma
  bar           Enable, disable, or inspect the optional Omarchy top bar
EOF
}

readonly script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if [[ -x /usr/lib/frankenstein/diagnostics ]]; then
  diagnostics=/usr/lib/frankenstein/diagnostics
else
  diagnostics=$script_dir/../libexec/frankenstein-diagnostics
fi

command_name=${1:-}
[[ -z $command_name ]] || shift

case $command_name in
  watchdog)
    if [[ -x /usr/lib/frankenstein/watchdog ]]; then
      exec /usr/lib/frankenstein/watchdog "$@"
    fi
    exec "$script_dir/../libexec/frankenstein-watchdog" "$@"
    ;;
  inspect|doctor|verify)
    exec "$diagnostics" "$command_name" "$@"
    ;;
  install)
    exec /usr/lib/frankenstein/setup "$@"
    ;;
  switch)
    if (($#)); then
      exec /usr/bin/omarchy-default-desktop "$@"
    fi
    exec /usr/bin/omarchy-default-desktop --choose-and-switch
    ;;
  recover)
    exec /usr/lib/frankenstein/uninstall "$@"
    ;;
  repair-sddm)
    exec /usr/lib/frankenstein/setup --shell preserve --login frankenstein --default keep "$@"
    ;;
  background)
    exec /usr/bin/frankenstein-background "$@"
    ;;
  adopt-kde-shell)
    exec /usr/lib/frankenstein/adopt-kde-shell "$@"
    ;;
  preflight)
    exec /usr/lib/frankenstein/setup --preflight "$@"
    ;;
  setup)
    exec /usr/lib/frankenstein/setup "$@"
    ;;
  uninstall)
    exec /usr/lib/frankenstein/uninstall "$@"
    ;;
  settings)
    exec /usr/bin/frankenstein-settings "$@"
    ;;
  desktop)
    if (($#)); then
      exec /usr/bin/omarchy-default-desktop "$@"
    fi
    exec /usr/bin/omarchy-default-desktop --choose-and-switch
    ;;
  check|enable|disable|menu|bar)
    exec /usr/bin/frankenstein-shell-adapter "$command_name" "$@"
    ;;
  help|--help|-h|'')
    usage
    ;;
  *)
    echo "Unknown command: $command_name" >&2
    usage >&2
    exit 2
    ;;
esac
