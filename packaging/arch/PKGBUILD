source=()
for _source_spec in "${_local_sources[@]}"; do
  source+=("${_source_spec%%::*}")
done
unset _source_spec

prepare() {
  "$srcdir/frankenstein-kde-bar-compat" \
    /usr/share/omarchy/shell/plugins/bar/Bar.qml \
    "$srcdir/kde-Bar.qml"
}

