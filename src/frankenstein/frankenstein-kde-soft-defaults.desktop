[Desktop Entry]
Type=Application
Name=Frankenstein KDE first-login defaults
Comment=Finish one-shot project defaults without replacing user choices
Exec=/usr/bin/frankenstein-kde-soft-defaults login
OnlyShowIn=KDE;
NoDisplay=true
X-KDE-autostart-phase=2
